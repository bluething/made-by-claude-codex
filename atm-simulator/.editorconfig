root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Console transcripts: the prompt "$ " ends with a space that is part of the output.
[src/test/resources/example-session/*.txt]
trim_trailing_whitespace = false
